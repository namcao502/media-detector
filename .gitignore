.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
packages/
!packages/build/

# Test and coverage output
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.trx

# Publish output
publish/
*.publishsettings

# misc
.DS_Store
*.pem
.env*

# brainstorm files
.superpowers/

