# Build output. desktop/.gitignore also carries bin/ and obj/ so the rule
# applies at every project level, not just here.
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# The vendored-ffmpeg drop point. Its README explains what goes there and must
# survive the bin/ rule above.
!bin/README.md

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
packages/
!packages/build/

# Test and coverage output
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.trx

# Publish output
publish/
*.publishsettings

# misc
.DS_Store
*.pem
.env*

# brainstorm files
.superpowers/

# scratch: filename preview dump (not part of the app)
/playlist-names.txt
/playlist-names2.txt
