<Window x:Class="MediaDetector.App.Views.MetadataFixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MediaDetector.App.Views"
        Title="Fix metadata" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPage}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <v:NotNullToVisibility x:Key="ShowIfSet"/>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="Fix metadata" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12">
            <Run Text="Rewrites the title/artist embedded in an already-downloaded file, so music apps that read the tag (not the filename) show the right name."/>
        </TextBlock>

        <Border Style="{StaticResource Row}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Text" Value="{Binding FileName}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFile}" Value="False">
                                    <Setter Property="Text" Value="No file chosen"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Content="Choose file..." Command="{Binding BrowseCommand}"
                        Style="{StaticResource PillNeutral}" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <TextBlock Text="Title" Style="{StaticResource SectionLabel}"/>
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                  IsEnabled="{Binding HasFile}"/>

        <TextBlock Text="Artist" Style="{StaticResource SectionLabel}"/>
        <TextBox Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                  IsEnabled="{Binding HasFile}"/>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="{Binding Status, Converter={StaticResource ShowIfSet}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Text" Value="{Binding Status}"/>
                    <Setter Property="Foreground" Value="{DynamicResource StatusOk}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextStatusError}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- IsCancel: WPF closes the window on click (or Esc) with no
                 command or code-behind needed, a built-in dialog convention,
                 not a Click handler. -->
            <Button Content="Close" IsCancel="True" Style="{StaticResource PillNeutral}"
                    Margin="0,0,8,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PillPrimary}"
                    IsEnabled="{Binding CanSave}"/>
        </StackPanel>
    </StackPanel>
</Window>
