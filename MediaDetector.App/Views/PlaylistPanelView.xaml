<UserControl x:Class="MediaDetector.App.Views.PlaylistPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:MediaDetector.App.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:models="clr-namespace:MediaDetector.Core.Models;assembly=MediaDetector.Core"
             xmlns:v="clr-namespace:MediaDetector.App.Views">
    <UserControl.Resources>
        <v:BoolToVisibility x:Key="Show"/>
        <v:BoolToVisibility x:Key="Hide" Invert="True"/>
        <v:NotNullToVisibility x:Key="ShowIfSet"/>
        <v:FormatLabelConverter x:Key="FormatLabel"/>

        <!-- Used as ItemTemplate on both pickers, which also drives the closed
             box via SelectionBoxItemTemplate. -->
        <DataTemplate x:Key="FormatItem">
            <TextBlock Text="{Binding Converter={StaticResource FormatLabel}}" FontSize="12"/>
        </DataTemplate>

        <ObjectDataProvider x:Key="AudioFormats" MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:PlaylistAudioFormat"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="VideoQualities" MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:PlaylistVideoQuality"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <!-- Grid, not StackPanel: the track list takes the star row so it grows
             and shrinks with the window, and the summary below it always stays
             on screen. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- header -->
                <RowDefinition Height="Auto"/>   <!-- setup block -->
                <RowDefinition Height="Auto"/>   <!-- overall progress -->
                <RowDefinition Height="*"/>      <!-- track list -->
                <RowDefinition Height="Auto"/>   <!-- summary -->
            </Grid.RowDefinitions>

            <!-- Header. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding PlaylistTitle}" FontWeight="SemiBold" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                        <Run Text="{Binding Total, Mode=OneWay}"/><Run Text=" tracks"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding DownloadLabel}"
                        Command="{Binding DownloadAllCommand}" Style="{StaticResource PillPrimary}"
                        Visibility="{Binding SetupVisible, Converter={StaticResource Show}}"/>
                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}"
                        Style="{StaticResource PillNeutral}"
                        Foreground="{DynamicResource TextStatusError}"
                        Visibility="{Binding IsDownloading, Converter={StaticResource Show}}"/>
            </Grid>

            <!-- Setup block: format picker + clean-names toggle. -->
            <StackPanel Grid.Row="1" Margin="0,10,0,0"
                        Visibility="{Binding SetupVisible, Converter={StaticResource Show}}">
                <!-- Bound to ModeIndex, so the tab and the request cannot disagree.
                     It used to be unbound, with the pickers reading this control's
                     SelectedIndex directly through a bool converter that an int
                     never satisfies. -->
                <ctrl:SegmentedControl x:Name="ModeTabs"
                                       SelectedIndex="{Binding ModeIndex, Mode=TwoWay}">
                    <ListBoxItem Content="Audio"/>
                    <ListBoxItem Content="Video" IsEnabled="{Binding CanUseVideo}"/>
                </ctrl:SegmentedControl>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Format" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Source={StaticResource AudioFormats}}"
                              SelectedItem="{Binding AudioFormat}" FontSize="12"
                              ItemTemplate="{StaticResource FormatItem}"
                              Visibility="{Binding IsAudioMode, Converter={StaticResource Show}}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Source={StaticResource VideoQualities}}"
                              SelectedItem="{Binding VideoQuality}" FontSize="12"
                              ItemTemplate="{StaticResource FormatItem}"
                              Visibility="{Binding IsVideoMode, Converter={StaticResource Show}}"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="At once" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ConcurrencyOptions}"
                              SelectedItem="{Binding Concurrency}" FontSize="12" MinWidth="56"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               Text="tracks downloading in parallel"/>
                </Grid>

                <TextBlock Text="MP3 and video need ffmpeg." Style="{StaticResource Muted}"
                           Margin="0,6,0,0"
                           Visibility="{Binding CanUseVideo, Converter={StaticResource Hide}}"/>
            </StackPanel>

            <!-- Overall progress. -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0"
                        Visibility="{Binding ProgressVisible, Converter={StaticResource Show}}">
                <Grid>
                    <TextBlock Text="{Binding ProgressHeadline}" Style="{StaticResource Secondary}"
                               FontWeight="Medium"/>
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Secondary}"
                               FontWeight="Medium">
                        <Run Text="{Binding OverallPercent, Mode=OneWay, StringFormat={}{0:0}}"/><Run Text="%"/>
                    </TextBlock>
                </Grid>
                <ProgressBar Style="{StaticResource ThinBar}" Margin="0,6,0,0"
                             Minimum="0" Maximum="100" Value="{Binding OverallPercent, Mode=OneWay}"/>
                <Grid Margin="0,6,0,0"
                      Visibility="{Binding IsDownloading, Converter={StaticResource Show}}">
                    <TextBlock Text="{Binding DetailText, TargetNullValue={x:Static sys:String.Empty}}"
                               Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock HorizontalAlignment="Right" FontSize="11"
                               Foreground="{DynamicResource TextStatusWarn}"
                               Visibility="{Binding IsStalled, Converter={StaticResource Show}}">
                        <Run Text="no update for "/><Run Text="{Binding IdleSeconds, Mode=OneWay}"/><Run Text="s"/>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <!-- Track list. Fills the star row, so it grows and shrinks with the
                 window like the video/audio format list does; whatever does not
                 fit scrolls, so a 1200-track playlist is still fully reachable
                 and the summary below it is always on screen. -->
            <!-- HorizontalScrollBarVisibility=Disabled is load-bearing, not tidying:
                 a ListBox defaults it to Auto, which measures every item with
                 INFINITE width. TextTrimming can never fire under that, so a long
                 title stretched its row past the viewport instead of ellipsising
                 and each row ended up a different width. Disabled pins items to
                 the viewport width, which is what makes the ellipsis work. -->
            <ListBox x:Name="TrackList" Grid.Row="3" ItemsSource="{Binding Tracks}"
                     Margin="0,6,0,0"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="{DynamicResource RadiusSm}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource BgFill}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <!-- Fixed, NOT Auto. An Auto column is only as wide
                                     as its own row's content, so "retry 3/5" and
                                     "80%" gave neighbouring rows different name
                                     widths and the right edge zig-zagged. -->
                                <ColumnDefinition Width="132"/>
                            </Grid.ColumnDefinitions>

                            <ctrl:StatusIcon Grid.Column="0" Width="14" Height="14" Margin="0,0,6,0"
                                             Kind="{Binding Icon}" Label="{Binding IconLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Index}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>

                            <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondary}"
                                       ToolTip="{Binding OriginalTitle}"/>

                            <!-- One status cell, three mutually exclusive states
                                 (see ShowInlineProgress), every one pinned right so
                                 the numbers line up down the column. -->
                            <Grid Grid.Column="3" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding ShowInlineProgress, Converter={StaticResource Show}}">
                                    <ProgressBar Style="{StaticResource ThinBar}" Width="80" Height="4"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding Percent, Mode=OneWay}"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                               Width="34" TextAlignment="Right" Margin="6,0,0,0">
                                        <Run Text="{Binding Percent, Mode=OneWay, StringFormat={}{0:0}}"/><Run Text="%"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Merge/convert/embed report no percentage at all,
                                     so the label is what explains a stopped bar. -->
                                <TextBlock Text="{Binding PhaseText}" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Visibility="{Binding HasPhase, Converter={StaticResource Show}}"/>

                                <TextBlock Text="{Binding Note}" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextStatusWarn}"
                                           Visibility="{Binding HasNote, Converter={StaticResource Show}}"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Summary. Clearing it is what brings the picker back, so the
                 finished state is not a dead end. -->
            <StackPanel Grid.Row="4" Margin="0,10,0,0"
                        Visibility="{Binding Summary, Converter={StaticResource ShowIfSet}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ctrl:StatusIcon Grid.Column="0" Kind="{Binding SummaryIcon}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding SummaryLabel}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Open Folder" Command="{Binding OpenFolderCommand}"
                                Style="{StaticResource PillNeutral}" Margin="0,0,8,0"/>
                        <Button Content="{Binding RestartLabel}" Command="{Binding StartAgainCommand}"
                                Style="{StaticResource PillPrimary}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding OpenError}" FontSize="11" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextStatusErrorTitle}"
                           Visibility="{Binding OpenError, Converter={StaticResource ShowIfSet}}"/>
                <TextBlock Text="{Binding FatalError}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextStatusErrorTitle}"
                           Visibility="{Binding FatalError, Converter={StaticResource ShowIfSet}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
