<UserControl x:Class="MediaDetector.App.Views.FormatTabsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:MediaDetector.App.Controls"
             xmlns:v="clr-namespace:MediaDetector.App.Views">
    <UserControl.Resources>
        <v:BoolToVisibility x:Key="Show"/>
        <v:BoolToVisibility x:Key="Hide" Invert="True"/>
        <v:NotNullToVisibility x:Key="ShowIfSet"/>

        <!-- One row per format. Accent border marks the recommended one. -->
        <DataTemplate x:Key="FormatRowTemplate">
            <Border Margin="0,0,0,8" Padding="14,10"
                    Background="{DynamicResource BgCard}"
                    CornerRadius="{DynamicResource RadiusMd}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <Border Background="{DynamicResource BgBadge}" CornerRadius="{DynamicResource RadiusSm}"
                                    Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBadge}"/>
                            </Border>
                            <TextBlock Text="{Binding Ext}" FontWeight="Medium" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Codec}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding FpsText}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Visibility="{Binding FpsText, Converter={StaticResource ShowIfSet}}"/>
                            <Border Background="{DynamicResource Accent}" CornerRadius="{DynamicResource RadiusSm}"
                                    Padding="6,2" Margin="0,0,6,0"
                                    Visibility="{Binding IsRecommended, Converter={StaticResource Show}}">
                                <TextBlock Text="Best" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <!-- iPhone playability tag: YouTube's best audio is
                                 opus-in-webm, which iOS will not play natively. -->
                            <Border CornerRadius="{DynamicResource RadiusSm}" Padding="6,2" BorderThickness="1"
                                    Visibility="{Binding IsAudio, Converter={StaticResource Show}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource StatusOk}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsApplePlayable}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource BgStatusWarn}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderStatusWarn}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="iPhone"/>
                                            <Setter Property="Foreground" Value="{DynamicResource StatusOk}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsApplePlayable}" Value="False">
                                                    <Setter Property="Text" Value="Not on iPhone"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextStatusWarn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </WrapPanel>

                        <!-- MinWidths, so "unknown size" vs "3.2 MB" and "Download"
                             vs "Retry" cannot give neighbouring rows a different
                             right edge. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       MinWidth="76" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Content="Cancel" Command="{Binding CancelCommand}"
                                    Style="{StaticResource PillNeutral}" MinWidth="88"
                                    Foreground="{DynamicResource TextStatusError}"
                                    Visibility="{Binding IsDownloading, Converter={StaticResource Show}}"/>
                            <Button Content="{Binding ButtonLabel}" Command="{Binding DownloadCommand}"
                                    Style="{StaticResource PillPrimary}" MinWidth="88"
                                    Visibility="{Binding CanStart, Converter={StaticResource Show}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Progress area: four states, exactly as DownloadProgress.tsx. -->
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding ShowProgress, Converter={StaticResource Show}}">

                        <!-- Active. -->
                        <StackPanel Visibility="{Binding ShowBar, Converter={StaticResource Show}}">
                            <Grid>
                                <TextBlock Text="{Binding PhaseLabel, TargetNullValue=Starting}"
                                           Style="{StaticResource Secondary}" FontWeight="Medium"/>
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Secondary}"
                                           FontWeight="Medium">
                                    <Run Text="{Binding Percent, Mode=OneWay, StringFormat={}{0:0.#}}"/><Run Text="%"/>
                                </TextBlock>
                            </Grid>
                            <ProgressBar Style="{StaticResource ThinBar}" Margin="0,6,0,0"
                                         Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"/>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource Muted}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock HorizontalAlignment="Right" FontSize="11"
                                           Foreground="{DynamicResource TextStatusWarn}"
                                           Visibility="{Binding IsStalled, Converter={StaticResource Show}}">
                                    <Run Text="no update for "/><Run Text="{Binding IdleSeconds, Mode=OneWay}"/><Run Text="s"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- Finished: the bar gives way to a verified row naming
                             the real folder. -->
                        <Grid Visibility="{Binding SavedPath, Converter={StaticResource ShowIfSet}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ctrl:StatusIcon Grid.Column="0" Kind="Check" Label="Download complete"
                                             Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Secondary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SavedPath}">
                                <Run Text="Saved to "/><Run Text="{Binding SavedFolder, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Grid.Column="2" Content="Open Folder" Command="{Binding OpenFolderCommand}"
                                    Style="{StaticResource PillNeutral}"/>
                        </Grid>

                        <!-- Cancelled: yt-dlp leaves a resumable .part file, so
                             say so rather than implying nothing was written. -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding Cancelled, Converter={StaticResource Show}}">
                            <ctrl:StatusIcon Kind="Warn" Label="Download cancelled" Margin="0,0,8,0"/>
                            <TextBlock Text="Cancelled  -  a partial file may remain in the folder"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextStatusWarn}"/>
                        </StackPanel>

                        <!-- Error. -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding Error, Converter={StaticResource ShowIfSet}}">
                            <ctrl:StatusIcon Kind="Error" Label="Download failed" Margin="0,0,8,0"
                                             VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap"
                                       MaxWidth="480"
                                       Foreground="{DynamicResource TextStatusErrorTitle}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding OpenError}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextStatusErrorTitle}"
                                   Visibility="{Binding OpenError, Converter={StaticResource ShowIfSet}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Tabs pinned, list scrolls. A video can offer 20+ formats; letting the
         list grow is what used to push the page past the window. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- iOS segmented control: Video | Audio, with counts. -->
        <ctrl:SegmentedControl Grid.Row="0" x:Name="Tabs" SelectedIndex="0" Margin="0,0,0,12">
            <ListBoxItem>
                <TextBlock>
                    <Run Text="Video "/><Run Text="{Binding VideoCount, Mode=OneWay}" FontWeight="Normal"/>
                </TextBlock>
            </ListBoxItem>
            <ListBoxItem>
                <TextBlock>
                    <Run Text="Audio "/><Run Text="{Binding AudioCount, Mode=OneWay}" FontWeight="Normal"/>
                </TextBlock>
            </ListBoxItem>
        </ctrl:SegmentedControl>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding VideoRows}"
                              ItemTemplate="{StaticResource FormatRowTemplate}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Tabs}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding AudioRows}"
                              ItemTemplate="{StaticResource FormatRowTemplate}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Tabs}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
