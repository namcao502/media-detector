<Window x:Class="MediaDetector.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:MediaDetector.App.Controls"
        xmlns:v="clr-namespace:MediaDetector.App.Views"
        xmlns:vm="clr-namespace:MediaDetector.App.ViewModels"
        Title="Media Detector" Width="720" MinWidth="600"
        Height="800" MinHeight="700"
        Background="{DynamicResource BgPage}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <v:BoolToVisibility x:Key="Show"/>
        <v:BoolToVisibility x:Key="Hide" Invert="True"/>
        <v:NotNullToVisibility x:Key="ShowIfSet"/>
        <v:RowStateToIcon x:Key="RowIcon"/>
        <v:RowStateToBrushKey x:Key="RowBg" Kind="Bg"/>
        <v:RowStateToBrushKey x:Key="RowTitle" Kind="Title"/>
        <v:RowStateToBrushKey x:Key="RowMessage" Kind="Message"/>
        <v:VisibilityToStarHeight x:Key="StarIfVisible"/>
        <v:VisibilityToStarHeight x:Key="StarIfVisibleElseAuto" AutoWhenHidden="True"/>
    </Window.Resources>

    <!-- Not a scrolling page. The chrome (header, status, save-to, URL, error)
         sits in Auto rows that keep their place, and the one star row absorbs
         whatever is left. Anything of unbounded length (the format list, the
         playlist's tracks) scrolls INSIDE its own panel instead. Previously the
         whole page scrolled, so a long playlist pushed the title and the URL
         box off the top. -->
    <!-- Stretch, NOT MaxWidth + Center. That combination sizes the Grid to its
         CONTENT and only clamps at the maximum, so every card was as wide as
         the longest string in it: the column was narrow while the status row
         said "Checking..." and jumped wider the moment the version numbers
         arrived. Letting the Grid stretch to the window's client area (its
         default alignment) ties its width to the window, not to what is
         inside it, which is also what lets the window resize horizontally. -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- "Dependencies" -->
            <RowDefinition Height="Auto"/>   <!-- dependency status -->
            <RowDefinition Height="Auto"/>   <!-- "Save to" -->
            <RowDefinition Height="Auto"/>   <!-- save to -->
            <RowDefinition Height="Auto"/>   <!-- "YouTube link" -->
            <RowDefinition Height="Auto"/>   <!-- url -->
            <RowDefinition Height="Auto"/>   <!-- error banner -->
            <RowDefinition Height="Auto"/>   <!-- "Download" -->
            <!-- Star whenever either the format list or the playlist card is
                 showing, since both now scroll internally and need real space
                 to scroll within. Bound to HasResults (both flows), NOT to
                 FormatsView's own Visibility alone, which left this row Auto
                 whenever a playlist was active instead of Formats, so the
                 playlist's track list had nothing bounding it and could not
                 scroll. Auto when neither is showing. -->
            <RowDefinition MinHeight="0"
                           Height="{Binding HasResults,
                                    Converter={StaticResource StarIfVisibleElseAuto}}"/>
        </Grid.RowDefinitions>

            <!-- Header on one line. It used to be a stacked 28pt title plus a
                 subtitle, ~100px of pure decoration; with section labels and
                 ten track rows all wanting height, that did not fit the 1040px
                 work area. The title bar already says the app's name. -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Media Detector" FontSize="19" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="YouTube &amp; YouTube Music" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="10,2,0,0"/>
                </StackPanel>
                <Button Content="Fix metadata" Command="{Binding OpenMetadataFixCommand}"
                        Style="{StaticResource PillNeutral}" HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ToolTip="Rewrite the title/artist tag on an already-downloaded file"/>
                <Button Content="{Binding Theme.Glyph}" Command="{Binding Theme.ToggleCommand}"
                        Style="{StaticResource PillNeutral}" HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="Toggle light / dark"/>
            </Grid>

            <!-- Dependency status. Collapses to one line when everything is OK;
                 force-expanded when there is a problem, because then there is an
                 action to take. -->
            <TextBlock Grid.Row="1" Text="Dependencies" Style="{StaticResource SectionLabel}"/>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ctrl:StatusIcon Grid.Column="0" Kind="{Binding Status.Icon}" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Status.Headline}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding Status.Subline}" Style="{StaticResource Secondary}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Recheck" Command="{Binding Status.RecheckCommand}"
                                Style="{StaticResource PillNeutral}" Margin="8,0,0,0"
                                IsEnabled="{Binding Status.IsBusy, Converter={StaticResource Hide}}"/>
                        <Button Grid.Column="3" Content="..." Command="{Binding Status.ToggleExpandedCommand}"
                                Style="{StaticResource PillNeutral}" Margin="8,0,0,0"
                                Visibility="{Binding Status.Healthy, Converter={StaticResource Show}}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Status.Rows}" Margin="0,10,0,0"
                                  Visibility="{Binding Status.IsOpen, Converter={StaticResource Show}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{DynamicResource RadiusMd}" Padding="10,8" Margin="0,0,0,4"
                                        Background="{Binding State, Converter={StaticResource RowBg}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ctrl:StatusIcon Grid.Column="0" Width="14" Height="14"
                                                         Margin="0,0,10,0"
                                                         Kind="{Binding State, Converter={StaticResource RowIcon}}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{Binding State, Converter={StaticResource RowTitle}}"/>
                                            <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{Binding State, Converter={StaticResource RowMessage}}"
                                                       Margin="0,2,0,0"/>
                                            <!-- Which copy answered. Two green rows look identical
                                                 without it. -->
                                            <TextBlock Text="{Binding ResolvedFrom}" FontSize="10" TextWrapping="Wrap"
                                                       Opacity="0.65" Margin="0,2,0,0"
                                                       Foreground="{Binding State, Converter={StaticResource RowMessage}}"
                                                       Visibility="{Binding ResolvedFrom, Converter={StaticResource ShowIfSet}}"/>
                                            <!-- HelpUrl is only ever set on a row with a problem,
                                                 so this doubles as the "needs vendoring" hint. -->
                                            <TextBlock Text="{Binding DataContext.Status.VendorHint,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="10" TextWrapping="Wrap"
                                                       Opacity="0.65" Margin="0,2,0,0"
                                                       Foreground="{Binding State, Converter={StaticResource RowMessage}}"
                                                       Visibility="{Binding HelpUrl, Converter={StaticResource ShowIfSet}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <!-- Bound to HasAction, NOT to Action: a boxed
                                                 RowAction.None is neither null nor an empty
                                                 string, so the null-check converter put an
                                                 Install button on every satisfied row. -->
                                            <Button Content="{Binding ActionLabel}"
                                                    Style="{StaticResource PillPrimary}" MinWidth="90"
                                                    Command="{Binding DataContext.Status.RunActionCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding HasAction, Converter={StaticResource Show}}"/>
                                            <Button Content="Get it" Margin="0,0,0,4"
                                                    Style="{StaticResource PillNeutral}" MinWidth="90"
                                                    Command="{Binding DataContext.Status.OpenHelpCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding HelpUrl}"
                                                    Visibility="{Binding HelpUrl, Converter={StaticResource ShowIfSet}}"/>
                                            <Button Content="Open folder"
                                                    Style="{StaticResource PillNeutral}" MinWidth="90"
                                                    Command="{Binding DataContext.Status.OpenVendorFolderCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Visibility="{Binding HelpUrl, Converter={StaticResource ShowIfSet}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Installer log. -->
                    <Border Background="{DynamicResource LogBg}" CornerRadius="{DynamicResource RadiusSm}"
                            Padding="8" Margin="0,8,0,0" MaxHeight="160"
                            Visibility="{Binding Status.LogLines.Count, Converter={StaticResource ShowIfSet}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Status.LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource LogText}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Save-to folder. The inline "Save to" caption is gone: the section
                 label above the card now says it. -->
            <TextBlock Grid.Row="3" Text="Save to" Style="{StaticResource SectionLabel}"/>
            <Border Grid.Row="4" Style="{StaticResource Row}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding OutputDir.Dir}" VerticalAlignment="Center"
                               FontSize="12" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding OutputDir.Dir}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Browse" Command="{Binding OutputDir.BrowseCommand}"
                                Style="{StaticResource PillNeutral}" Margin="8,0,0,0"/>
                        <Button Content="Open" Command="{Binding OutputDir.OpenCommand}"
                                Style="{StaticResource PillNeutral}" Margin="8,0,0,0"/>
                        <Button Content="Reset" Command="{Binding OutputDir.ResetCommand}"
                                Style="{StaticResource PillNeutral}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- URL input. The focus ring goes on the BOX, not the inner TextBox:
                 otherwise it draws around the bare input and reads as a blue
                 rectangle floating inside the field. -->
            <TextBlock Grid.Row="5" Text="YouTube link" Style="{StaticResource SectionLabel}"/>
            <Border x:Name="UrlShell" Grid.Row="6" Margin="0,0,0,8">
                <!-- Style set only here, not also as an attribute: XAML forbids
                     setting the same property twice (MC3024). -->
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Row}">
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Padding" Value="15,11"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                             FocusVisualStyle="{x:Null}" BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" FontSize="13"
                             ctrl:PlaceholderText.Text="Paste a YouTube video or playlist link"
                             IsEnabled="{Binding Status.DepsReady}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding DetectCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Detect" Command="{Binding DetectCommand}"
                            Style="{StaticResource PillPrimary}" Margin="8,0,0,0"
                            IsEnabled="{Binding Status.DepsReady}"/>
                </Grid>
            </Border>

            <!-- Error banner. -->
            <Border Grid.Row="7" Background="{DynamicResource BgStatusError}"
                    BorderBrush="{DynamicResource BorderStatusError}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLg}" Padding="14,10" Margin="0,0,0,12"
                    Visibility="{Binding HasError, Converter={StaticResource Show}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ctrl:StatusIcon Grid.Column="0" Kind="Error" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextStatusError}"/>
                    <Button Grid.Column="2" Content="Dismiss" Command="{Binding DismissErrorCommand}"
                            Style="{StaticResource PillNeutral}" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Everything the detect produced. The two list panels take star rows
                 sized by their own visibility, so whichever is on screen gets all
                 the leftover height and neither leaves a gap when absent. -->
            <!-- One shared checkbox, not a per-video toggle: CleanNames feeds
                 BOTH the single-video and playlist requests (MainViewModel.cs),
                 so it has to live somewhere visible regardless of which one is
                 showing. A prior per-row "Cleaned/Original" toggle only flipped
                 its own local preview flag and never actually reached the real
                 download request, so it was removed in favour of this single
                 control. -->
            <Grid Grid.Row="8" Visibility="{Binding HasResults, Converter={StaticResource Show}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Download" Style="{StaticResource SectionLabel}"/>
                <CheckBox Grid.Column="1" Content="Clean names" IsChecked="{Binding CleanNames}"
                          Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Formats and the playlist card both claim the star row:
                         each list scrolls internally and grows with the window.
                         They are never visible at once, so only one row is ever
                         actually Star; StarIfVisible yields 0 for the hidden one. -->
                    <RowDefinition Height="{Binding Visibility, ElementName=FormatsView,
                                            Converter={StaticResource StarIfVisible}}"/>
                    <RowDefinition Height="{Binding Visibility, ElementName=PlaylistView,
                                            Converter={StaticResource StarIfVisible}}"/>
                </Grid.RowDefinitions>

            <!-- Detected video: info, file name, format tabs. -->
            <ContentControl Grid.Row="0" Content="{Binding Media}"
                            Visibility="{Binding Media, Converter={StaticResource ShowIfSet}}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                           TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0">
                                    <Run Text="{Binding Channel, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <v:FileNameRow Grid.Row="1" DataContext="{Binding FileName}" Margin="0,0,0,12"
                           Visibility="{Binding Converter={StaticResource ShowIfSet}}"/>

            <v:FormatTabsView Grid.Row="2" x:Name="FormatsView" DataContext="{Binding Formats}"
                              Visibility="{Binding Converter={StaticResource ShowIfSet}}"/>

            <v:PlaylistPanelView Grid.Row="3" x:Name="PlaylistView"
                                 DataContext="{Binding PlaylistPanel}" Margin="0,12,0,0"
                                 Visibility="{Binding Converter={StaticResource ShowIfSet}}"/>
            </Grid>

    </Grid>
</Window>
